import { Ordering as Orders, Shipping, Billing as Finance } from "./context-catalog.tni"
import { CommonTypes } from "./common-types.tni"

context map FulfillmentMap {
  customer Shipping {
    integrationPatterns: ["AntiCorruptionLayer"]
  } -> supplier Orders {
    integrationPatterns: ["OpenHostService", "PublishedLanguage"]
  }

  partner Orders {
    integrationPatterns: ["Conformist"]
  } <-> partner Finance {
    integrationPatterns: ["AntiCorruptionLayer"]
  }

  separateWays Shipping -x- Finance

  sharedKernel CommonTypes {
    participants: [Orders, Shipping]
  }
}
