import "./context-catalog.tni"
import "./ordering.tni"
import "./ordering-events.tni"
import { FulfillmentMap } from "./context-map.tni"
import { CommonTypes as Common } from "./common-types.tni"

in bounded context Shipping {
  value object OrderId mirrors Ordering.Order.OrderId {
    raw: string
  }

  aggregate Shipment {
    root entity Shipment {
      method start() {
        precondition "The shipment is pending."
        transition status from Pending to Started
        emits ShipmentStarted
        behavior "Start shipment processing for its associated order."
        postcondition "The shipment status is Started and ShipmentStarted is emitted."
      }

      identifier id: ShipmentId
      orderId: OrderId
      status: ShipmentStatus initial Pending
      currency: Common.Currency
      routing: RoutingCode
    }

    value object ShipmentId {
      raw: string
    }
  }

  repository ShipmentRepository {
    manages Shipment.Shipment
  }

  factory ShipmentFactory {
    method createShipment(id: ShipmentId, orderId: OrderId, routing: RoutingCode) returns Shipment.Shipment {
      precondition "The shipment and order identifiers are valid."
      behavior "Create a pending shipment for the identified order with the supplied routing code."
      postcondition "The returned shipment has the supplied identifiers and routing code and is Pending."
    }
  }

  enum ShipmentStatus {
    Pending,
    Started
  }

  event ShipmentStarted

  read model ShipmentSummary {
    shipmentId: ShipmentId
    orderId: OrderId
    status: ShipmentStatus
    routing: RoutingCode
  }

  query repository ShipmentSummaryRepository {
    serves ShipmentSummary
    reads from Shipment
  }

  read model ShipmentRequestView {
    orderId: string
    lineCount: integer
  }

  query repository ShipmentRequestRepository {
    serves ShipmentRequestView
  }

  read model ShipmentTracking {
    shipmentId: ShipmentId
    orderId: OrderId
    status: ShipmentStatus
    routing: RoutingCode
  }

  query repository ShipmentTrackingRepository {
    serves ShipmentTracking
  }

  projector ShipmentProjector {
    method onOrderPlaced(source: Ordering.Contracts.OrderPlacedV1) {
      projects ShipmentRequestView
      behavior "Project [[Ordering.Contracts.OrderPlacedV1.orderId]] and [[Ordering.Contracts.OrderPlacedV1.lines.sku]] into [[ShipmentRequestView]]."
    }

    method onShipmentStarted(source: ShipmentStarted) {
      projects ShipmentTracking
      behavior "Project the started shipment into [[ShipmentTracking]]."
    }
  }

  domain service Authorization {
    method authorize(role: Common.Role, action: string) returns boolean {
      precondition "The role and requested action are known."
      behavior "Allow the action only when the supplied role is authorized for it."
      postcondition "The result indicates whether the role is authorized for the action."
    }
  }

  application service ShipmentApplication {
    method createShipment(orderId: OrderId, routing: RoutingCode) {
      precondition "The order has been placed and is eligible for fulfillment."
      invokes ShipmentFactory.createShipment
      behavior "First, authorize the Common.Role.FulfillmentOperator role for creating a shipment with [[Authorization.authorize]]; stop if authorization fails. Then create a pending shipment for the order with the supplied routing code."
      postcondition "A pending shipment exists for the order."
    }

    method dispatchShipment(shipmentId: ShipmentId) {
      precondition "The selected shipment is pending."
      invokes Shipment.Shipment.start
      behavior "First, authorize the Common.Role.FulfillmentOperator role for dispatching a shipment with [[Authorization.authorize]]; stop if authorization fails. Then start the selected pending shipment."
      postcondition "The shipment is started."
    }

    method onOrderPlaced(source: Ordering.Contracts.OrderPlacedV1) {
      precondition "The incoming contract contains a valid order identifier and delivery data."
      invokes createShipment
      behavior "First, authorize the Common.Role.System role for handling the incoming event with [[Authorization.authorize]]; stop if authorization fails. Then create a pending shipment for [[Ordering.Contracts.OrderPlacedV1.orderId]], mapping [[Ordering.Contracts.OrderPlacedV1.delivery.city]] and [[Ordering.Contracts.OrderPlacedV1.lines.sku]] into the local shipment."
      postcondition "A pending shipment exists for the incoming order."
    }
  }

  module Operations {
    exposes TrackingCode, RoutingCode, ShipmentQueries, ShipmentLookup

    value object TrackingCode {
      raw: string
    }

    value object RoutingCode {
      raw: string
    }

    data object ShipmentLookup {
      shipmentId: string
      orderId: string
      status: ShipmentStatus
      routing: RoutingCode
    }

    query service ShipmentQueries {
      method findPendingShipments(region: string) returns List<ShipmentLookup> {
        reads from ShipmentSummaryRepository
        behavior "Return the pending shipments for [[region]] with their status and routing."
        postcondition "The result contains published shipment lookups."
      }

      method findRequest(orderId: string) returns ShipmentRequestView {
        reads from ShipmentRequestRepository
        behavior "Read the projector-maintained shipment request view for [[orderId]]."
        postcondition "The result is the current shipped-request projection."
      }

      method findTracking(shipmentId: ShipmentId) returns ShipmentTracking {
        reads from ShipmentTrackingRepository
        behavior "Read the projector-maintained tracking view for [[shipmentId]]."
        postcondition "The result is the current shipment-tracking projection."
      }
    }
  }

  value object ShipmentRouting {
    routingCode: RoutingCode
  }

  module AuditOperations {
    exposes AuditCode

    value object AuditCode {
      raw: string
    }
  }

  module Fulfillment {
    depends on Operations, AuditOperations

    value object ShipmentMetadata {
      trackingCode: TrackingCode
    }
  }
}
