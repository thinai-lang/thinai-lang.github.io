// Sharing tour: same-document context map, shared-kernel service,
// published query contract, an authorized cross-context query read,
// and a command-led journey with a query read step.
shared kernel Shared {
  value object Money {
    amount: decimal
    currency: string
  }

  domain service Rates {
    method convert(amount: decimal, rate: decimal) returns decimal {
      behavior "Convert [[amount]] at [[rate]]."
    }
  }
}

bounded context Source

bounded context Consumer

context map LocalMap {
  customer Consumer -> supplier Source

  sharedKernel Shared {
    participants: [Source, Consumer]
  }
}

in bounded context Source {
  module Api {
    exposes Queries, LookupResult, LookupMetadata, LookupStatus

    data object LookupResult {
      payload: string
      metadata: LookupMetadata
      status: LookupStatus
    }

    data object LookupMetadata {
      source: string
    }

    enum LookupStatus {
      Available,
      Missing
    }

    query service Queries {
      method lookup() returns LookupResult {
        behavior "Return the published value and its metadata."
      }
    }
  }

  application service SourceApp {
    method convert(amount: decimal, rate: decimal) {
      invokes Shared.Rates.convert
    }
  }
}

in bounded context Consumer {
  application service ConsumerApp {
    method fetch() {
      reads from Source.Api.Queries.lookup
      behavior "Read [[Source.Api.LookupMetadata.source]] and [[Source.Api.LookupResult.status]] from the published query."
    }
  }
}

actor Reader

journey ReadPublishedValue {
  by Reader {
    invoke Source.Api.Queries.lookup
      with "the key selected by the reader"

    invoke Consumer.ConsumerApp.fetch
      with "the value returned by [[Source.Api.Queries.lookup.result.payload]]"
  }
}
