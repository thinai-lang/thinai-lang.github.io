// Module tour: nested modules, re-exports, dependencies, published methods,
// and a local mirror of a module-private identifier.
bounded context ModulesTour

in bounded context ModulesTour {
  module Outer {
    exposes Inner, PublicValue

    module Inner {
      exposes InnerValue

      aggregate Request {
        root entity Request {
          identifier id: RequestId
        }

        value object RequestId {
          raw: string
        }
      }

      value object InnerValue {
        raw: string
      }
    }

    // Inner is exposed; HiddenInner is intentionally not exposed by Outer.
    module HiddenInner {
      exposes HiddenValue

      value object HiddenValue {
        raw: string
      }
    }

    value object PublicValue {
      raw: string
    }
  }

  module DirectConsumer {
    depends on Outer.HiddenInner

    value object UsesHidden {
      hiddenValue: HiddenInner.HiddenValue
    }
  }

  module Policies {
    exposes Pricing

    domain service Pricing {
      method price(amount: decimal) returns decimal {
        behavior "Price the supplied amount."
      }
    }
  }

  module PricingConsumer {
    depends on Policies

    application service UsesPricing {
      method calculate(amount: decimal) returns decimal {
        invokes Policies.Pricing.price
      }
    }
  }

  module Consumer {
    depends on Outer

    value object UsesPublic {
      publicValue: PublicValue
      innerValue: Outer.Inner.InnerValue
    }
  }

  data object OutsideUsesNested {
    innerValue: Outer.Inner.InnerValue
  }

  module Api {
    // Only the command method is published; the service container is not.
    exposes Handler.run

    application service Handler {
      method run() {}
      method audit() {}
    }
  }

  module ApiConsumer {
    depends on Api

    event Triggered

    application service UsesApi {
      method onTriggered(source: Triggered) {
        invokes Api.Handler.run
      }
    }
  }
}

bounded context MirrorTour

in bounded context MirrorTour {
  // A local identifier mirror may name a module-private identifier in another
  // bounded context; this is the sanctioned cross-context identifier use.
  value object MirroredRequestId mirrors ModulesTour.Outer.Inner.Request.RequestId {
    raw: string
  }
}

context map Mirroring {
  customer MirrorTour -> supplier ModulesTour
}
